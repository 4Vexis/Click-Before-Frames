{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "4vexis.click-before-frames",
    "name": "Click Before Frames",
    "version": "v1.3.0",
    "developer": "4Vexis",
    "description": "Predicts early clicks and holds them until they are safe. Includes a floating V menu.",
    "settings": {
        "show-v": {
            "type": "bool",
            "name": "Show V button",
            "default": true
        },
        "low-ticks": {
            "type": "int",
            "name": "LOW max delay (ticks)",
            "description": "240 ticks = 1 second. 4 ticks = 1 frame at 60 FPS.",
            "default": 4,
            "min": 1,
            "max": 32
        },
        "med-ticks": {
            "type": "int",
            "name": "MED max delay (ticks)",
            "default": 8,
            "min": 1,
            "max": 32
        },
        "high-ticks": {
            "type": "int",
            "name": "HIGH max delay (ticks)",
            "default": 16,
            "min": 1,
            "max": 32
        },
        "horizon-ticks": {
            "type": "int",
            "name": "Prediction length (ticks)",
            "description": "How far ahead the ghost looks. Higher is smarter but slower.",
            "default": 60,
            "min": 20,
            "max": 200
        },
        "sim-budget-ms": {
            "type": "float",
            "name": "Max prediction time (ms)",
            "description": "If the search takes longer, your click goes through normally.",
            "default": 6,
            "min": 1,
            "max": 20
        }
    },
    "dependencies": {
        "geode.node-ids": ">=v1.23.3"
    }
}
